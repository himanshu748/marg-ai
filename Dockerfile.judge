FROM python:3.12.13-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
COPY requirements-verified.txt .
RUN pip install --no-cache-dir -r requirements-verified.txt && pip check
COPY marg ./marg
COPY eval ./eval
COPY models ./models
COPY tests/fixtures/clip3s.mp4 ./tests/fixtures/clip3s.mp4
USER 10001:10001
EXPOSE 8080
CMD ["python","-m","uvicorn","marg.api.app:app","--host","0.0.0.0","--port","8080","--workers","1"]
