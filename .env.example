# MargAI environment reference. The app reads real environment variables only (no .env loader):
#   set -a; . ./.env; set +a
# Never commit real tokens or ARNs.

# --- Local workbench (matches the README quickstart) ---
MARG_DATA_ROOT=outputs/workbench
MARG_READ_ONLY=0
# mock = deterministic offline review; bedrock = Amazon Bedrock (needs MARG_BEDROCK_ENABLED=1 and AWS credentials)
MARG_AGENT_LLM=mock
MARG_BEDROCK_ENABLED=0
# Optional shared token for write endpoints; set MARG_COOKIE_SECURE=1 behind HTTPS
MARG_API_TOKEN=
MARG_COOKIE_SECURE=0
# Upload and job limits (defaults shown; leave commented to use them)
# MARG_MAX_VIDEO_BYTES=268435456
# MARG_MAX_GPX_BYTES=5242880
MARG_JOB_WORKERS=2
MARG_JOB_CAPACITY=8

# --- Amazon Bedrock agent (optional) ---
AWS_REGION=us-east-1
MARG_BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
MARG_BEDROCK_MAX_TOKENS=1024
MARG_BEDROCK_CONNECT_TIMEOUT=5
MARG_BEDROCK_READ_TIMEOUT=60
MARG_BEDROCK_MAX_ATTEMPTS=2

# --- AWS runtime (set by the CloudFormation stack; leave empty locally) ---
MARG_S3_BUCKET=
MARG_S3_PREFIX=
MARG_S3_CACHE_DIR=/tmp/marg-cache
MARG_SQS_QUEUE_URL=
MARG_WORK_ORDERS_TABLE=margai-work-orders
MARG_SURVEYS_TABLE=margai-surveys

# --- infra/deploy.sh inputs ---
MARG_DEPLOY_READ_ONLY=true
MARG_ALLOW_INSECURE_WRITES=false
# MARG_API_TOKEN_SECRET_ARN=arn:aws:secretsmanager:...
# MARG_DASHBOARD_DOMAIN=margai.example.com
# MARG_CERTIFICATE_ARN=arn:aws:acm:...
MARG_CPU_ARCHITECTURE=ARM64
